# Use the OpenAI-compatible v1 endpoint of the Foundry resource.
# Examples:
# https://YOUR-RESOURCE.openai.azure.com/openai/v1
# https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
FOUNDRY_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1

# The deployment name shown in Microsoft Foundry (not necessarily the model ID).
FOUNDRY_MODEL_DEPLOYMENT=zava-datagen

# Keep the real key only in .env. Never commit it.
FOUNDRY_API_KEY=replace-me
